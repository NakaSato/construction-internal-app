{
  "name": "react-vite-spa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "bun --bun vite --host",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun --bun vitest",
    "test:run": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "type-check": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "bun --bun eslint . --ext ts,tsx --fix",
    "lint:strict": "bun --bun eslint . --ext ts,tsx --max-warnings 0",
    "build:analyze": "ANALYZE=true bun --bun vite build",
    "clean": "rm -rf dist node_modules/.vite .bun",
    "start": "bun --bun vite --host",
    "install:clean": "rm -rf node_modules bun.lockb && bun install",
    "deps:update": "bun update"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@react-pdf/renderer": "^4.5.1",
    "@react-spring/web": "^10.1.2",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.21",
    "@types/socket.io-client": "^3.0.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.42.2",
    "immer": "^11.1.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "react-virtualized": "^9.22.6",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "tesseract.js"
  ]
}
